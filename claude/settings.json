{
  "cleanupPeriodDays": 90,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files)",
      "Bash(git ls-files *)",
      "Bash(git blame *)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list *)",
      "Bash(git remote -v)",
      "Bash(git worktree list)",
      "Bash(git worktree list *)",
      "Bash(git stash list)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git merge-base *)",
      "Bash(git cherry *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr status)",
      "Bash(gh run list)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list)",
      "Bash(gh issue list *)",
      "Bash(gh repo view)",
      "Bash(gh repo view *)",
      "Bash(gh auth status)",
      "Bash(mise ls)",
      "Bash(mise ls *)",
      "Bash(mise which *)",
      "Bash(mise current)",
      "Bash(mise current *)",
      "Bash(mise where *)",
      "Bash(mise ls-remote *)",
      "Bash(mise doctor)",
      "Bash(brew info *)",
      "Bash(brew list)",
      "Bash(brew list *)",
      "Bash(brew outdated)",
      "Bash(brew search *)",
      "Bash(xcrun simctl list)",
      "Bash(xcrun simctl list *)",
      "Bash(xcrun --find *)",
      "Bash(xcrun xcresulttool *)",
      "Bash(uv *)",
      "Bash(pnpm *)",
      "Bash(npm *)",
      "Bash(ruff *)",
      "Bash(swiftlint *)",
      "Bash(git-cliff *)",
      "Bash(cat *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(rg *)",
      "Bash(jq *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(diff *)",
      "Bash(stat *)",
      "Bash(yazi)",
      "Bash(btm)"
    ],
    "deny": [
      "Bash(rg *--pre*)",
      "Read(~/.ssh/**)",
      "Read(~/.bootstrap/**)",
      "Read(~/.pi/agent/auth.json)",
      "Read(~/.pi/agent/mcp.json)",
      "Read(~/.claude.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.netrc)",
      "Read(~/.aws/credentials)",
      "Read(~/.docker/config.json)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)"
    ],
    "ask": [
      "Bash(gh gist *)",
      "Bash(gh secret *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh auth token*)",
      "Edit(~/Projects/src/github.com/itsmeduncan/dotfiles/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/forge-session.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/context-guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/bash-guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/auto-format.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/memory-capture.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "feedbackDrafts": "notify",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-4-8": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "environment": [
      "$defaults",
      "Source control: the GitHub org itsmeduncan belongs to the user, and every repo under it is the user's own. Other orgs, self-hosted remotes, tailnet hosts and services that machine-local managed settings name as the user's own are the user's too. Every other GitHub org is shared or third-party: the user is at most one member among others, and branches, PRs and history the user did not create belong to other people.",
      "Tailnets: a *.ts.net name or 100.64.0.0/10 address that the machine-local managed settings do not name as the user's tailnet belongs to another tailnet and is external."
    ]
  }
}
