{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(git)",
      "Bash(gh *)",
      "Bash(gh)",
      "Bash(*&& git *)",
      "Bash(*&& gh *)",
      "Bash(*; git *)",
      "Bash(*; gh *)",
      "Bash(*| git *)",
      "Bash(*| gh *)",
      "Bash(mise *)",
      "Bash(uv *)",
      "Bash(pnpm *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(ruff *)",
      "Bash(just *)",
      "Bash(atuin *)",
      "Bash(yazi)",
      "Bash(btm)",
      "Bash(cat *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(brew *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(swiftlint *)",
      "Bash(xcrun *)",
      "Bash(xcodebuild *)",
      "Bash(xcodegen *)",
      "Bash(git-cliff *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/auto-format.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/commonplace-capture.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "dark-ansi",
  "skipAutoPermissionPrompt": true,
  "agentPushNotifEnabled": true
}
