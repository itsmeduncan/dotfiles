{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(git)",
      "Bash(gh *)",
      "Bash(gh)",
      "Bash(*&& git *)",
      "Bash(*&& gh *)",
      "Bash(*; git *)",
      "Bash(*; gh *)",
      "Bash(*| git *)",
      "Bash(*| gh *)",
      "Bash(mise *)",
      "Bash(uv *)",
      "Bash(pnpm *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(python *)",
      "Bash(ruff *)",
      "Bash(just *)",
      "Bash(atuin *)",
      "Bash(yazi)",
      "Bash(btm)",
      "Bash(cat *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(brew *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(swiftlint *)",
      "Bash(xcrun *)",
      "Bash(xcodebuild *)",
      "Bash(xcodegen *)",
      "Bash(git-cliff *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/auto-format.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "prime@arthai": true
  },
  "extraKnownMarketplaces": {
    "arthai": {
      "source": {
        "source": "github",
        "repo": "ArthTech-AI/arthai-plugins"
      }
    }
  },
  "effortLevel": "xhigh",
  "theme": "dark-ansi",
  "skipAutoPermissionPrompt": true
}
