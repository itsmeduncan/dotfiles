{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(git)",
      "Bash(gh *)",
      "Bash(gh)",
      "Bash(*&& git *)",
      "Bash(*&& gh *)",
      "Bash(*; git *)",
      "Bash(*; gh *)",
      "Bash(*| git *)",
      "Bash(*| gh *)",
      "Bash(mise *)",
      "Bash(uv *)",
      "Bash(pnpm *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(ruff *)",
      "Bash(just *)",
      "Bash(atuin *)",
      "Bash(yazi)",
      "Bash(btm)",
      "Bash(cat *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(brew *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(jq *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(diff *)",
      "Bash(stat *)",
      "Bash(swiftlint *)",
      "Bash(xcrun *)",
      "Bash(xcodebuild *)",
      "Bash(xcodegen *)",
      "Bash(git-cliff *)"
    ],
    "defaultMode": "auto"
  },
  "autoMode": {
    "environment": [
      "$defaults",
      "Source control: the GitHub orgs itsmeduncan, getwhelk, wellrunpartners and AqenAI belong to the user, and every repo under them is the user's own.",
      "Self-hosted git: ssh://whelk-forge/ and ssh://duncan@scriptorium.tail1cf291.ts.net/ are the user's own git remotes.",
      "Homelab: hosts on the user's Tailscale tailnet (*.ts.net names, 100.64.0.0/10 addresses, and the short names darksaber, scriptorium, mini and duncans-mac-mini) are personal machines that only the user operates and shares with no one. They run the user's own services: the scriptorium workspace and its CI, and commonplace memory. One-shot ssh commands to them are routine development work, not access to someone else's production. Destructive or irreversible actions there still need the user's request, and CI builders still run live jobs.",
      "Trusted internal services: https://scriptorium.tail1cf291.ts.net:8443 and http://darksaber.tail1cf291.ts.net:8000 and :8001 are the user's own MCP services."
    ]
  },
  "cleanupPeriodDays": 90,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/auto-format.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/commonplace-capture.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-4-8": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "model": "claude-opus-4-8"
}
