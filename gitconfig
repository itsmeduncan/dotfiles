[alias]
  l = log --date=human
  st = status -sb
  co = checkout
  ci = commit
  bl = blame
  br = branch
  d = diff
  dp = --no-pager diff
  dw = --word-diff
  ds = diff --staged
  ffm = merge --ff-only
  f = fetch -p
  p = push
  su = submodule update --init --recursive
  suf = submodule update --init --recursive --force
  undo = reset --soft HEAD~1
  amend = commit --amend --no-edit
  wip = !git add -A && git commit -m 'wip'
  cleanup = !git branch --merged main | grep -v '\\*\\|main' | xargs -n 1 git branch -d
  lg = log --oneline --graph --decorate -20
[user]
	name = Duncan Grazier
	email = itsmeduncan@users.noreply.github.com
[color]
  ui = auto
[core]
	excludesfile = ~/.gitignore
	editor = nvim
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
[difftool]
  prompt = false
[github]
  user = itsmeduncan
[browser "gitscm"]
  cmd = /bin/sh -c 'open http://git-scm.com/docs/$(basename $1 .html)' --
[help]
  browser = gitscm
  autocorrect = prompt
[init]
  defaultBranch = main
[push]
	default = simple
	autoSetupRemote = true
[pull]
	rebase = true
[fetch]
	prune = true
[merge]
	conflictstyle = zdiff3
[rebase]
	autosquash = true
	updateRefs = true
[rerere]
	enabled = true
[diff]
	algorithm = histogram
[transfer]
	fsckObjects = true
[branch]
	sort = -committerdate
[column]
	ui = auto
[credential]
    helper = osxkeychain
[url "git@github.com:"]
    insteadOf = https://github.com/
[filter "lfs"]
	required = true
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	clean = git-lfs clean -- %f
[commit]
    template = ~/.gitmessage
