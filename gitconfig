[alias]
	l = log --date=human
	st = status -sb
	co = checkout
	ci = commit
	bl = blame
	br = branch
	d = diff
	dp = --no-pager diff
	dw = --word-diff
	ds = diff --staged
	ffm = merge --ff-only
	f = fetch -p
	p = push
	su = submodule update --init --recursive
	suf = submodule update --init --recursive --force
	undo = reset --soft HEAD~1
	amend = commit --amend --no-edit
	wip = !git add -u && git commit -m 'wip'  # uses add -u (tracked only) to avoid committing secrets/artifacts
	cleanup = !git branch --merged main | grep -v '\\*\\|main' | xargs -n 1 git branch -d
	absorb = absorb --and-rebase
	lg = log --oneline --graph --decorate -20
# ---------------------------------------------------------------------------
# WARNING: Personal identity — forkers MUST change these or use includeIf
# with a local ~/.gitconfig.personal. See git help config.
# ---------------------------------------------------------------------------
# WARNING: Personal identity — forkers MUST change name/email or use
# includeIf with a local gitconfig (see `git help config`).
[user]
	name = Duncan Grazier
	email = itsmeduncan@users.noreply.github.com
# ---------------------------------------------------------------------------
# SSH commit signing via 1Password.
#
# Tracked config sets up the SIGNER (op-ssh-sign) but does NOT enable signing
# by default — that's opt-in per-machine to avoid breaking commits on fresh
# clones where 1Password / the SSH key haven't been set up yet.
#
# To enable on this machine, run:
#   git config --global user.signingKey "ssh-ed25519 AAAA... your-key"
#   git config --global commit.gpgsign true
#   git config --global tag.gpgsign true
#
# Or drop into ~/.gitconfig.local (loaded below via includeIf):
#   [user]
#       signingKey = ssh-ed25519 AAAA... your-key
#   [commit]
#       gpgsign = true
#   [tag]
#       gpgsign = true
# ---------------------------------------------------------------------------
[gpg]
	format = ssh
[gpg "ssh"]
	# 1Password's SSH-sign helper. Cask `1password-cli` provides this on macOS.
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[includeIf "gitdir:~/"]
	# Per-machine overrides: signing key, commit.gpgsign, work-vs-personal identity.
	# Not tracked. Safe to be missing.
	path = ~/.gitconfig.local
[color]
	ui = auto
[core]
	excludesfile = ~/.gitignore
	editor = nvim
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	dark = true
	syntax-theme = base16
	minus-style = "syntax #200000"
	minus-emph-style = "syntax #3f0000"
	plus-style = "syntax #001a00"
	plus-emph-style = "syntax #003300"
	line-numbers-minus-style = "#5f3030"
	line-numbers-plus-style = "#305f30"
	line-numbers-zero-style = "#3a3a3a"
	hunk-header-style = "syntax bold"
	hunk-header-decoration-style = "omit"
[difftool]
	prompt = false
[github]
	user = itsmeduncan
[browser "gitscm"]
	cmd = /bin/sh -c 'open http://git-scm.com/docs/$(basename $1 .html)' --
[help]
	browser = gitscm
	autocorrect = prompt
[init]
	defaultBranch = main
[push]
	default = simple
	autoSetupRemote = true
[pull]
	rebase = true
[fetch]
	prune = true
[merge]
	conflictstyle = zdiff3
[rebase]
	autosquash = true
	updateRefs = true
[rerere]
	enabled = true
[diff]
	algorithm = histogram
[transfer]
	fsckObjects = true
[branch]
	sort = -committerdate
[column]
	ui = auto
[credential]
	helper = osxkeychain
[url "git@github.com:"]
	insteadOf = https://github.com/
[filter "lfs"]
	required = true
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	clean = git-lfs clean -- %f
[commit]
	template = ~/.gitmessage
[credential "https://github.com"]
	helper = 
	helper = !/Users/duncan/.local/share/mise/shims/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/Users/duncan/.local/share/mise/shims/gh auth git-credential
