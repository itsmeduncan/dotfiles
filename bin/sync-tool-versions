#!/bin/bash
# Regenerate .tool-versions (asdf format) from mise.toml's [tools] section.
#
# Why: .tool-versions is the asdf-canonical way to declare runtime versions
# per-project. mise reads it. asdf reads it. So do most other version-managers.
# It's the portable lingua franca for "what Node/Python/etc. should this use."
#
# Scope: runtimes only (node/python/ruby/go/java/bun + a few popular CLIs).
# Most of our CLI tools (eza, bat, ripgrep, etc.) aren't asdf-pluginable;
# they stay mise-only.
#
# Usage:
#   bin/sync-tool-versions          # write .tool-versions
#   bin/sync-tool-versions --check  # exit 1 if .tool-versions is stale

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
MISE_TOML="$REPO_ROOT/mise.toml"
TOOL_VERSIONS="$REPO_ROOT/.tool-versions"

# Tools that have asdf plugins and are worth emitting.
# Anything in mise.toml NOT listed here stays mise-only.
_ASDF_COMPATIBLE=(node python ruby go java bun)

generate() {
  echo "# Generated by bin/sync-tool-versions from mise.toml. Do not edit by hand."
  echo "# Runtimes only — most CLI tools in mise.toml have no asdf plugin equivalent."
  for tool in "${_ASDF_COMPATIBLE[@]}"; do
    # Match: tool = "version" or tool="version" with optional whitespace.
    local version
    version="$(grep -E "^[[:space:]]*${tool}[[:space:]]*=" "$MISE_TOML" \
      | head -1 \
      | sed -E 's/^[^=]*=[[:space:]]*"([^"]+)".*/\1/')"
    if [ -n "$version" ]; then
      printf "%-8s %s\n" "$tool" "$version"
    fi
  done
}

case "${1:-}" in
  --check)
    if ! diff -u "$TOOL_VERSIONS" <(generate) >/dev/null 2>&1; then
      echo "ERROR: .tool-versions is out of sync with mise.toml" >&2
      echo "Run: bin/sync-tool-versions" >&2
      echo "Diff:" >&2
      diff -u "$TOOL_VERSIONS" <(generate) >&2 || true
      exit 1
    fi
    echo ".tool-versions in sync with mise.toml"
    ;;
  "" | --write)
    generate >"$TOOL_VERSIONS"
    echo "wrote $TOOL_VERSIONS"
    ;;
  -h | --help)
    sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    echo "Unknown arg: $1" >&2
    exit 64
    ;;
esac
